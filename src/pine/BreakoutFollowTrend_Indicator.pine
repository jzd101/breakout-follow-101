//@version=5
indicator("Breakout Follow Trend [Indicator]", overlay=true, max_boxes_count=500, max_lines_count=500)

// ==========================================
// Inputs
// ==========================================
// Risk Management (Used for TP/SL levels)
grp_risk = "Risk Management"
inpRiskPct    = input.float(0.9, "Risk % per Trade", minval=0.1, step=0.1, group=grp_risk, tooltip="Used to calculate position sizing for labels")
inpRR         = input.float(2.0, "Risk:Reward Ratio", minval=0.1, step=0.1, group=grp_risk)
inpATRMult    = input.float(2.0, "ATR Multiplier (SL)", minval=0.1, step=0.1, group=grp_risk)

// Indicators
grp_ind = "Indicators"
inpUseEMA     = input.bool(true, "Use EMA Trend Filter", group=grp_ind)
inpEMAPeriod  = input.int(200, "EMA Period", minval=1, group=grp_ind)
inpBBPeriod   = input.int(15, "Bollinger Bands Period", minval=1, group=grp_ind)
inpBBDev      = input.float(1.5, "Bollinger Bands Deviation", minval=0.1, step=0.1, group=grp_ind)
inpATRPeriod  = input.int(14, "ATR Period", minval=1, group=grp_ind)

// Volume Filter
grp_vol = "Volume Filter"
inpUseVol     = input.bool(true, "Use Volume Filter", group=grp_vol)
inpVolPeriod  = input.int(15, "Volume MA Period", minval=1, group=grp_vol)

// Time & Filters
grp_time = "Time Filters"
inpStartHour  = input.int(7, "Start Hour (0-23)", minval=0, maxval=23, group=grp_time)
inpEndHour    = input.int(20, "End Hour (0-23)", minval=0, maxval=23, group=grp_time)

// ==========================================
// Calculations
// ==========================================
// Moving Average (EMA)
emaVal = ta.ema(close, inpEMAPeriod)

// Bollinger Bands
[basis, upperBB, lowerBB] = ta.bb(close, inpBBPeriod, inpBBDev)

// ATR (Wilder's / RMA)
atrVal = ta.atr(inpATRPeriod)

// Volume MA
volMA = ta.sma(volume, inpVolPeriod)

// Time Filter
isInTimeWindow = inpStartHour < inpEndHour ? (hour >= inpStartHour and hour < inpEndHour) : (hour >= inpStartHour or hour < inpEndHour)

// ==========================================
// Signal Conditions
// ==========================================
longCondition  = (not inpUseEMA or close > emaVal) and ta.crossover(close, upperBB) and (not inpUseVol or volume > volMA) and isInTimeWindow
shortCondition = (not inpUseEMA or close < emaVal) and ta.crossunder(close, lowerBB) and (not inpUseVol or volume > volMA) and isInTimeWindow

// ==========================================
// Visuals & Position Tools
// ==========================================
// Core Indicators
plot(inpUseEMA ? emaVal : na, color=color.new(color.blue, 0), title="EMA Trend")
p1 = plot(upperBB, color=color.new(color.gray, 50), title="Upper BB")
p2 = plot(lowerBB, color=color.new(color.gray, 50), title="Lower BB")
fill(p1, p2, color=color.new(color.gray, 90), title="BB Background")

// Signal Markers
plotshape(longCondition,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Short Signal")

// Colors for Long/Short Tools (TradingView Style)
color_tp_fill = color.new(#089981, 80)
color_sl_fill = color.new(#f23645, 80)
color_tp_border = color.new(#089981, 30)
color_sl_border = color.new(#f23645, 30)
color_entry_line = color.new(color.gray, 20)

// Active Tool Tracking (Simplified for Indicator)
var box[] active_tp_boxes = array.new_box()
var box[] active_sl_boxes = array.new_box()
var line[] active_entry_lines = array.new_line()
var float[] active_tp_levels = array.new_float()
var float[] active_sl_levels = array.new_float()
var bool[] active_is_long = array.new_bool()

// 1. Update active boxes (Extend or Remove)
if array.size(active_tp_boxes) > 0
    for i = array.size(active_tp_boxes) - 1 to 0
        box tp_box = array.get(active_tp_boxes, i)
        box sl_box = array.get(active_sl_boxes, i)
        line en_line = array.get(active_entry_lines, i)
        float tp = array.get(active_tp_levels, i)
        float sl = array.get(active_sl_levels, i)
        bool is_l = array.get(active_is_long, i)
        
        // Extend to current bar
        box.set_right(tp_box, bar_index)
        box.set_right(sl_box, bar_index)
        line.set_x2(en_line, bar_index)
        
        // Check for exit (Price hits TP or SL)
        bool hit_tp = is_l ? high >= tp : low <= tp
        bool hit_sl = is_l ? low <= sl : high >= sl
        
        if hit_tp or hit_sl
            array.remove(active_tp_boxes, i)
            array.remove(active_sl_boxes, i)
            array.remove(active_entry_lines, i)
            array.remove(active_tp_levels, i)
            array.remove(active_sl_levels, i)
            array.remove(active_is_long, i)

// 2. Create New Tools on Signal
if longCondition or shortCondition
    float slDist = atrVal * inpATRMult
    float tpDist = slDist * inpRR
    float entryPrice = close
    float tp = longCondition ? entryPrice + tpDist : entryPrice - tpDist
    float sl = longCondition ? entryPrice - slDist : entryPrice + slDist
    
    box b_tp = box.new(bar_index, longCondition ? tp : entryPrice, bar_index, longCondition ? entryPrice : tp, bgcolor=color_tp_fill, border_color=na)
    box b_sl = box.new(bar_index, longCondition ? entryPrice : sl, bar_index, longCondition ? sl : entryPrice, bgcolor=color_sl_fill, border_color=na)
    line l_en = line.new(bar_index, entryPrice, bar_index, entryPrice, color=color_entry_line, width=1)
    
    array.push(active_tp_boxes, b_tp)
    array.push(active_sl_boxes, b_sl)
    array.push(active_entry_lines, l_en)
    array.push(active_tp_levels, tp)
    array.push(active_sl_levels, sl)
    array.push(active_is_long, longCondition)

// Alert Conditions
alertcondition(longCondition,  title="Breakout Long",  message="Long Signal: {{ticker}} Price {{close}}")
alertcondition(shortCondition, title="Breakout Short", message="Short Signal: {{ticker}} Price {{close}}")
