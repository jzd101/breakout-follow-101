//@version=5
indicator("Breakout Follow Trend [Indicator]", overlay=true)

// ==========================================
// Inputs
// ==========================================
// Risk Management
grp_risk = "Risk Management"
inpRiskPct    = input.float(0.9, "Risk % per Trade", minval=0.1, step=0.1, group=grp_risk)
inpRR         = input.float(2.0, "Risk:Reward Ratio", minval=0.1, step=0.1, group=grp_risk)
inpATRMult    = input.float(2.0, "ATR Multiplier (SL)", minval=0.1, step=0.1, group=grp_risk)

// Indicators
grp_ind = "Indicators"
inpUseEMA     = input.bool(true, "Use EMA Trend Filter", group=grp_ind)
inpEMAPeriod  = input.int(200, "EMA Period", minval=1, group=grp_ind)
inpBBPeriod   = input.int(15, "Bollinger Bands Period", minval=1, group=grp_ind)
inpBBDev      = input.float(1.5, "Bollinger Bands Deviation", minval=0.1, step=0.1, group=grp_ind)
inpATRPeriod  = input.int(14, "ATR Period", minval=1, group=grp_ind)

// Volume Filter
grp_vol = "Volume Filter"
inpUseVol     = input.bool(true, "Use Volume Filter", group=grp_vol)
inpVolPeriod  = input.int(15, "Volume MA Period", minval=1, group=grp_vol)

// Time & Filters
grp_time = "Time Filters"
inpStartHour  = input.int(7, "Start Hour (0-23)", minval=0, maxval=23, group=grp_time)
inpEndHour    = input.int(20, "End Hour (0-23)", minval=0, maxval=23, group=grp_time)

// Visuals
grp_viz = "Visual Settings"
inpShowTool   = input.bool(true, "Show Long/Short Visual Tool", group=grp_viz)
inpToolLength = input.int(20, "Visual Tool Extend (Bars)", minval=1, group=grp_viz)

// ==========================================
// Calculations
// ==========================================
// Moving Average (EMA)
emaVal = ta.ema(close, inpEMAPeriod)

// Bollinger Bands
[basis, upperBB, lowerBB] = ta.bb(close, inpBBPeriod, inpBBDev)

// ATR (Wilder's / RMA)
atrVal = ta.atr(inpATRPeriod)

// Volume MA
volMA = ta.sma(volume, inpVolPeriod)

// Time Filter
isInTimeWindow = inpStartHour < inpEndHour ? (hour >= inpStartHour and hour < inpEndHour) : (hour >= inpStartHour or hour < inpEndHour)

// Signal Logic
longCondition  = (not inpUseEMA or close > emaVal) and ta.crossover(close, upperBB) and (not inpUseVol or volume > volMA) and isInTimeWindow
shortCondition = (not inpUseEMA or close < emaVal) and ta.crossunder(close, lowerBB) and (not inpUseVol or volume > volMA) and isInTimeWindow

// ==========================================
// Visual Tool (Long/Short Box)
// ==========================================
if (inpShowTool)
    if (longCondition)
        slDist = atrVal * inpATRMult
        slPrice = close - slDist
        tpPrice = close + (slDist * inpRR)
        
        box.new(left=bar_index, top=tpPrice, right=bar_index + inpToolLength, bottom=close, 
                 bgcolor=color.new(color.green, 80), border_color=color.green, border_width=1)
        box.new(left=bar_index, top=close, right=bar_index + inpToolLength, bottom=slPrice, 
                 bgcolor=color.new(color.red, 80), border_color=color.red, border_width=1)

    if (shortCondition)
        slDist = atrVal * inpATRMult
        slPrice = close + slDist
        tpPrice = close - (slDist * inpRR)
        
        box.new(left=bar_index, top=close, right=bar_index + inpToolLength, bottom=tpPrice, 
                 bgcolor=color.new(color.green, 80), border_color=color.green, border_width=1)
        box.new(left=bar_index, top=slPrice, right=bar_index + inpToolLength, bottom=close, 
                 bgcolor=color.new(color.red, 80), border_color=color.red, border_width=1)

// ==========================================
// Plots
// ==========================================
plot(inpUseEMA ? emaVal : na, color=color.new(color.blue, 0), title="EMA Trend")
p1 = plot(upperBB, color=color.new(color.gray, 50), title="Upper BB")
p2 = plot(lowerBB, color=color.new(color.gray, 50), title="Lower BB")
fill(p1, p2, color=color.new(color.gray, 90), title="BB Background")

plotshape(longCondition, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Signal")

// Alerts
alertcondition(longCondition, title="Long Breakout", message="Breakout Follow Trend: LONG Signal on {{symbol}}")
alertcondition(shortCondition, title="Short Breakout", message="Breakout Follow Trend: SHORT Signal on {{symbol}}")
