//@version=5
strategy("Breakout Follow Trend [Strategy]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1, currency=currency.USD, commission_type=strategy.commission.cash_per_contract, commission_value=0.0)

// ==========================================
// Inputs
// ==========================================
// Risk Management
grp_risk = "Risk Management"
inpRiskPct    = input.float(0.9, "Risk % per Trade", minval=0.1, step=0.1, group=grp_risk, tooltip="Percentage of equity to risk based on SL distance")
inpRR         = input.float(2.0, "Risk:Reward Ratio", minval=0.1, step=0.1, group=grp_risk)
inpATRMult    = input.float(2.0, "ATR Multiplier (SL)", minval=0.1, step=0.1, group=grp_risk)
inpMaxTrades  = input.int(3, "Max Concurrent Trades", minval=1, group=grp_risk)

// Indicators
grp_ind = "Indicators"
inpUseEMA     = input.bool(true, "Use EMA Trend Filter", group=grp_ind)
inpEMAPeriod  = input.int(200, "EMA Period", minval=1, group=grp_ind)
inpBBPeriod   = input.int(15, "Bollinger Bands Period", minval=1, group=grp_ind)
inpBBDev      = input.float(1.5, "Bollinger Bands Deviation", minval=0.1, step=0.1, group=grp_ind)
inpATRPeriod  = input.int(14, "ATR Period", minval=1, group=grp_ind)

// Volume Filter
grp_vol = "Volume Filter"
inpUseVol     = input.bool(true, "Use Volume Filter", group=grp_vol)
inpVolPeriod  = input.int(15, "Volume MA Period", minval=1, group=grp_vol)

// Time & Filters
grp_time = "Time Filters"
inpStartHour  = input.int(7, "Start Hour (0-23)", minval=0, maxval=23, group=grp_time)
inpEndHour    = input.int(20, "End Hour (0-23)", minval=0, maxval=23, group=grp_time)
inpWeekendCl  = input.bool(false, "Weekend Close (Friday)", group=grp_time)
inpFridayTime = input.string("2345", "Friday Close Time (HHMM)", group=grp_time)

// ==========================================
// Calculations
// ==========================================
// Moving Average (EMA)
emaVal = ta.ema(close, inpEMAPeriod)

// Bollinger Bands
[basis, upperBB, lowerBB] = ta.bb(close, inpBBPeriod, inpBBDev)

// ATR (Wilder's / RMA)
atrVal = ta.atr(inpATRPeriod)

// Volume MA
volMA = ta.sma(volume, inpVolPeriod)

// Time Filter
isInTimeWindow = inpStartHour < inpEndHour ? (hour >= inpStartHour and hour < inpEndHour) : (hour >= inpStartHour or hour < inpEndHour)

// Friday Close Logic
isFridayClose = inpWeekendCl and dayofweek == dayofweek.friday and time >= timestamp(year, month, dayofmonth, int(str.tonumber(str.substring(inpFridayTime, 0, 2))), int(str.tonumber(str.substring(inpFridayTime, 2, 4))))

// ==========================================
// Strategy Execution
// ==========================================
// Position Sizing based on ATR Risk
// Risk Amount = Equity * (RiskPct / 100)
// Qty = Risk Amount / (SL Distance in Price)
slDist = atrVal * inpATRMult
riskAmount = strategy.equity * (inpRiskPct / 100)
posSize = riskAmount / slDist

// Signal Conditions
longCondition  = (not inpUseEMA or close > emaVal) and ta.crossover(close, upperBB) and (not inpUseVol or volume > volMA) and isInTimeWindow
shortCondition = (not inpUseEMA or close < emaVal) and ta.crossunder(close, lowerBB) and (not inpUseVol or volume > volMA) and isInTimeWindow

// Entry
if (longCondition and strategy.opentrades < inpMaxTrades)
    slPrice = close - slDist
    tpPrice = close + (slDist * inpRR)
    strategy.entry("Long", strategy.long, qty=posSize, comment="Long BB Breakout")
    strategy.exit("Exit Long", "Long", stop=slPrice, limit=tpPrice, comment_loss="SL", comment_profit="TP")

if (shortCondition and strategy.opentrades < inpMaxTrades)
    slPrice = close + slDist
    tpPrice = close - (slDist * inpRR)
    strategy.entry("Short", strategy.short, qty=posSize, comment="Short BB Breakout")
    strategy.exit("Exit Short", "Short", stop=slPrice, limit=tpPrice, comment_loss="SL", comment_profit="TP")

// Weekend Close
if (isFridayClose)
    strategy.close_all(comment="Weekend Close")

// ==========================================
// Visuals
// ==========================================
plot(inpUseEMA ? emaVal : na, color=color.new(color.blue, 0), title="EMA Trend")
p1 = plot(upperBB, color=color.new(color.gray, 50), title="Upper BB")
p2 = plot(lowerBB, color=color.new(color.gray, 50), title="Lower BB")
fill(p1, p2, color=color.new(color.gray, 90), title="BB Background")

plotshape(longCondition, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Entry Signal")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Entry Signal")
