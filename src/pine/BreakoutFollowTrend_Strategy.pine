//@version=5
strategy("Breakout Follow Trend [Strategy]", overlay=true, initial_capital=10000, currency=currency.USD, commission_type=strategy.commission.cash_per_contract, commission_value=0.0, pyramiding=10)

// ==========================================
// Inputs
// ==========================================
// Risk Management
grp_risk = "Risk Management"
inpRiskPct    = input.float(2.0, "Risk % per Trade", minval=0.1, step=0.1, group=grp_risk, tooltip="Percentage of base balance to risk based on SL distance")
inpRR         = input.float(2.0, "Risk:Reward Ratio", minval=0.1, step=0.1, group=grp_risk)
inpATRMult    = input.float(2.0, "ATR Multiplier (SL)", minval=0.1, step=0.1, group=grp_risk)
inpMaxTrades  = input.int(1, "Max Concurrent Trades", minval=1, group=grp_risk)
inpCompound   = input.bool(true, "Use Compounding Risk", group=grp_risk, tooltip="If true, risk = current equity * risk%. If false, risk = fixed balance * risk%.")
inpFixedBal   = input.float(10000.0, "Fixed Balance (when compounding off)", minval=0.0, group=grp_risk)
inpDailyLoss  = input.float(2.0, "Daily Loss Limit %", minval=0.0, step=0.1, group=grp_risk, tooltip="0 = disabled. Blocks new entries once realized daily P&L drops below this % of base balance.")

// Indicators
grp_ind = "Indicators"
inpUseEMA     = input.bool(true, "Use EMA Trend Filter", group=grp_ind)
inpEMAPeriod  = input.int(200, "EMA Period", minval=1, group=grp_ind)
inpBBPeriod   = input.int(15, "Bollinger Bands Period", minval=1, group=grp_ind)
inpBBDev      = input.float(1.5, "Bollinger Bands Deviation", minval=0.1, step=0.1, group=grp_ind)
inpATRPeriod  = input.int(14, "ATR Period", minval=1, group=grp_ind)

// Volume Filter
grp_vol = "Volume Filter"
inpUseVol     = input.bool(true, "Use Volume Filter", group=grp_vol)
inpVolPeriod  = input.int(15, "Volume MA Period", minval=1, group=grp_vol)

// Time & Filters
grp_time = "Time Filters"
inpStartHour  = input.int(7, "Start Hour (0-23)", minval=0, maxval=23, group=grp_time)
inpEndHour    = input.int(20, "End Hour (0-23)", minval=0, maxval=23, group=grp_time)
inpWeekendCl  = input.bool(false, "Weekend Close (Friday)", group=grp_time)
inpFridayTime = input.string("2345", "Friday Close Time (HHMM)", group=grp_time)

// ==========================================
// Calculations
// ==========================================
// Moving Average (EMA)
emaVal = ta.ema(close, inpEMAPeriod)

// Bollinger Bands
[basis, upperBB, lowerBB] = ta.bb(close, inpBBPeriod, inpBBDev)

// ATR (Wilder's / RMA)
atrVal = ta.atr(inpATRPeriod)

// Volume MA
volMA = ta.sma(volume, inpVolPeriod)

// Time Filter
isInTimeWindow = inpStartHour < inpEndHour ? (hour >= inpStartHour and hour < inpEndHour) : (hour >= inpStartHour or hour < inpEndHour)

// Weekend Block (matches MQ5 CheckWeekendClose: Friday past time, full Sat/Sun, Monday before StartHour)
fHour = int(str.tonumber(str.substring(inpFridayTime, 0, 2)))
fMin  = int(str.tonumber(str.substring(inpFridayTime, 2, 4)))
fridayMin   = fHour * 60 + fMin
nowMin      = hour * 60 + minute
isFridayPast    = dayofweek == dayofweek.friday and nowMin >= fridayMin
isWeekend       = dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday
isMondayBefore  = dayofweek == dayofweek.monday and hour < inpStartHour
isWeekendBlock  = inpWeekendCl and (isFridayPast or isWeekend or isMondayBefore)

// ==========================================
// Strategy Execution
// ==========================================
// Risk base — matches MQ5: compound uses live equity, otherwise fixed balance input
baseBal    = inpCompound ? strategy.equity : inpFixedBal
slDist     = atrVal * inpATRMult
riskAmount = baseBal * (inpRiskPct / 100)
posSize    = slDist > 0 ? riskAmount / slDist : 0.0

// Daily Loss Limit tracking (realized P&L) — matches MQ5
var float dailyPnL     = 0.0
var int   currentDay   = -1
var float dailyLossMax = 0.0
if dayofmonth != currentDay
    currentDay   := dayofmonth
    dailyPnL     := 0.0
    dailyLossMax := baseBal * (inpDailyLoss / 100)
if strategy.closedtrades > nz(strategy.closedtrades[1])
    dailyPnL := dailyPnL + strategy.closedtrades.profit(strategy.closedtrades - 1)
dailyLossHit = inpDailyLoss > 0 and dailyPnL <= -dailyLossMax

// Signal Conditions — plain comparison on closed bar (matches MQ5: close1 > upperBB / close1 < lowerBB)
volCond        = (not inpUseVol) or na(volMA) or volMA == 0 or volume > volMA
longCondition  = (not inpUseEMA or close > emaVal) and close > upperBB and volCond and isInTimeWindow and not isWeekendBlock and not dailyLossHit
shortCondition = (not inpUseEMA or close < emaVal) and close < lowerBB and volCond and isInTimeWindow and not isWeekendBlock and not dailyLossHit

// Capture TP/SL levels for the next bar's entry
float signal_tp = na
float signal_sl = na
if longCondition
    signal_sl := close - slDist
    signal_tp := close + (slDist * inpRR)
if shortCondition
    signal_sl := close + slDist
    signal_tp := close - (slDist * inpRR)

// Store levels in series to access them on the entry bar [1]
var float target_tp = na
var float target_sl = na
target_tp := signal_tp
target_sl := signal_sl

// Entry Execution — unique IDs per entry so each position has its own SL/TP (matches MQ5 hedge-like behavior within Pine's netted model)
var int entryCounter = 0
if (longCondition and strategy.opentrades < inpMaxTrades)
    entryCounter += 1
    id = "L" + str.tostring(entryCounter)
    strategy.entry(id, strategy.long, qty=posSize, comment="Long")
    strategy.exit("X" + id, id, stop=signal_sl, limit=signal_tp, comment_loss="SL", comment_profit="TP")

if (shortCondition and strategy.opentrades < inpMaxTrades)
    entryCounter += 1
    id = "S" + str.tostring(entryCounter)
    strategy.entry(id, strategy.short, qty=posSize, comment="Short")
    strategy.exit("X" + id, id, stop=signal_sl, limit=signal_tp, comment_loss="SL", comment_profit="TP")

// Weekend Close — close all positions while inside the weekend block
if (isWeekendBlock)
    strategy.close_all(comment="")

// ==========================================
// Visuals & Position Tools
// ==========================================
plot(inpUseEMA ? emaVal : na, color=color.new(color.blue, 0), title="EMA Trend")
p1 = plot(upperBB, color=color.new(color.gray, 50), title="Upper BB")
p2 = plot(lowerBB, color=color.new(color.gray, 50), title="Lower BB")
fill(p1, p2, color=color.new(color.gray, 90), title="BB Background")

// Colors for Long/Short Tools (100% TradingView Style)
color_tp_fill = color.new(#089981, 80)
color_sl_fill = color.new(#f23645, 80)
color_tp_border = color.new(#089981, 30)
color_sl_border = color.new(#f23645, 30)
color_entry_line = color.new(color.gray, 20)

// Persistent Arrays for Active Tools
var box[] active_tp_boxes = array.new_box()
var box[] active_sl_boxes = array.new_box()
var line[] active_entry_lines = array.new_line()

// 1. Extend all active tools to the current bar
if array.size(active_tp_boxes) > 0
    for i = 0 to array.size(active_tp_boxes) - 1
        box.set_right(array.get(active_tp_boxes, i), bar_index)
        box.set_right(array.get(active_sl_boxes, i), bar_index)
        line.set_x2(array.get(active_entry_lines, i), bar_index)

// 2. Handle New Entry detection
if strategy.opentrades > strategy.opentrades[1]
    // A new trade opened at the 'open' of this bar (Market Order from previous bar signal)
    float tp = target_tp[1]
    float sl = target_sl[1]
    float en = open
    bool is_long = strategy.position_size > strategy.position_size[1]
    
    // Create Visual Tools
    box b_tp = box.new(bar_index-1, is_long ? tp : en, bar_index, is_long ? en : tp, bgcolor=color_tp_fill, border_color=color_tp_border, border_width=1)
    box b_sl = box.new(bar_index-1, is_long ? en : sl, bar_index, is_long ? sl : en, bgcolor=color_sl_fill, border_color=color_sl_border, border_width=1)
    line l_en = line.new(bar_index-1, en, bar_index, en, color=color_entry_line, width=1)
    
    
    array.push(active_tp_boxes, b_tp)
    array.push(active_sl_boxes, b_sl)
    array.push(active_entry_lines, l_en)

// 3. Handle Exit detection (Prune active arrays)
if strategy.closedtrades > strategy.closedtrades[1]
    int num_closed = strategy.closedtrades - strategy.closedtrades[1]
    for i = 1 to num_closed
        if array.size(active_tp_boxes) > 0
            array.remove(active_tp_boxes, 0)
            array.remove(active_sl_boxes, 0)
            array.remove(active_entry_lines, 0)

// 4. Emergency Reset if flat
if strategy.position_size == 0 and array.size(active_tp_boxes) > 0
    array.clear(active_tp_boxes)
    array.clear(active_sl_boxes)
    array.clear(active_entry_lines)

